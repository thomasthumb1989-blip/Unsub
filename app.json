{
  "expo": {
    "name": "Unsub",
    "slug": "unsub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "unsub",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unsub.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.unsub.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F59E0B"
        }
      ],
      [
        "expo-alternate-app-icons",
        {
          "alternateIcons": {
            "Ocean": "./assets/icons/icon-lettermark-blue-dark.png",
            "Rose": "./assets/icons/icon-lettermark-red-dark.png",
            "Mint": "./assets/icons/icon-lettermark-green-dark.png",
            "Violet": "./assets/icons/icon-lettermark-purple-dark.png",
            "Minimal": "./assets/icons/icon-minimal-amber-dark.png",
            "Badge": "./assets/icons/icon-badge-amber-dark.png",
            "Outline": "./assets/icons/icon-outline-amber-dark.png",
            "Light": "./assets/icons/icon-lettermark-amber-light.png",
            "LightBadge": "./assets/icons/icon-badge-blue-light.png"
          }
        }
      ],
      "expo-web-browser"
    ]
  }
}
